# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Milestone 8: AI Document Intelligence (optional — the app runs normally
# without this; Documents work as plain file storage and "Analyze with
# PropPrepped AI" shows a graceful "not configured" message instead).
# Server-side only — never exposed to the browser, never prefixed NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-sonnet-5 if not set.
# DOCUMENT_INTELLIGENCE_MODEL=claude-sonnet-5
