# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Milestone 9: SaaS plans, Stripe billing, entitlements.
# All Stripe variables are server-side only — never exposed to the
# browser, never prefixed NEXT_PUBLIC_. Missing Stripe configuration does
# NOT crash the app: property management works fully on the Free plan,
# and any billing action shows "Billing is not configured yet." instead
# of erroring.

# Required for the Supabase service-role key used ONLY by the Stripe
# webhook handler (app/api/billing/webhook/route.ts) — see
# lib/supabase-server.ts for exactly why that one route needs it and no
# other route does. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Stripe secret key (test mode key starts with sk_test_...). Server-side only.
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret for the endpoint registered at
# /api/billing/webhook (starts with whsec_...). Server-side only.
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe recurring Price ids for the three paid plans (starts with
# price_...). Created in the Stripe Dashboard — see the M9 completion
# report for exact product/price setup instructions. The browser never
# supplies these directly; it only ever sends a plan identifier
# ("investor"/"portfolio"/"portfolio_pro") and the server maps it to the
# matching variable below.
STRIPE_INVESTOR_PRICE_ID=price_...
STRIPE_PORTFOLIO_PRICE_ID=price_...
STRIPE_PORTFOLIO_PRO_PRICE_ID=price_...

# Milestone 8: AI Document Intelligence (optional — the app runs normally
# without this; Documents work as plain file storage and "Analyze with
# PropRoster AI" shows a graceful "not configured" message instead).
# Server-side only — never exposed to the browser, never prefixed NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to a verified current model if not set — see
# lib/document-intelligence/model-config.ts for the verified list.
# DOCUMENT_INTELLIGENCE_MODEL=claude-sonnet-5

# Investment Tools 2.0 (optional — every address field works as plain
# manual entry without this; AddressAutocomplete gracefully falls back
# with no error shown to the user). Server-side only — the browser never
# sees this token; it's read by app/api/address/search and
# app/api/address/resolve, which proxy Mapbox's Search Box API.
# MAPBOX_ACCESS_TOKEN=pk....

# Investment Tools 2.0: Property Value & Comps (optional — without either
# of these, the page shows "Property valuation data is not configured
# yet." instead of an estimate; it NEVER falls back to an AI-generated
# guess). Set at most one — RentCast is preferred when both are present.
# Server-side only, read by app/api/valuation.
# RENTCAST_API_KEY=...
# ATTOM_API_KEY=...
